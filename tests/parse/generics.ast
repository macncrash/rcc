      (let m : HashMap::<String, Vec::<Option::<u32>>> = (call HashMap::new))
      (let (bind mut w) : Option::<Option::<i32>> = None)
      (let s = (method iter collect::<Vec::<_>>))
      (let n = (call size_of::<T>))

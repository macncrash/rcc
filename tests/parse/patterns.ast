(crate
  (fn pats
    (params (x: (u8, u8)) ((& (tuple a b)): &(i32, i32)) ((bind mut m): u8) (_: u8))
    (block
      (expr (match v
        (arm 0 => (block))
        (arm (| 1 2 3) => (block))
        (arm (range 4 ..= 9) => (block))
        (arm (range 10 .. 20) => (block))
        (arm (range 21 .. _) => (block))
        (arm (range _ ..= (neg 1)) => (block))
        (arm (| (range 'a' ..= 'z') (range 'A' ..= 'Z')) => (block))
        (arm (neg 5) => (block))
        (arm b'x' => (block))
        (arm "str" => (block))
        (arm (| true false) => (block))
        (arm (range MIN ..= MAX) => (block))
        (arm (range consts::A ..= consts::B) => (block))
        (arm (bind x @ (range 1 ..= 5)) => (block))
        (arm (bind ref r) => (block))
        (arm (bind ref mut rm) => (block))
        (arm (bind mut mv) => (block))
        (arm (tstruct Some (bind ref mut inner @ (tstruct Some _))) => (block))
        (arm (tstruct Some (| (tstruct Ok x) (tstruct Err x))) => (block))
        (arm (struct Foo::Bar a (b: (tuple c d)) (bind ref e) (bind mut f) ..) => (block))
        (arm (tstruct Foo::Baz _ .. z) => (block))
        (arm (path Foo::Unit) => (block))
        (arm None => (block))
        (arm (tuple first ..) => (block))
        (arm (tuple .. last) => (block))
        (arm (slice) => (block))
        (arm (slice one) => (block))
        (arm (slice head (bind tail @ ..)) => (block))
        (arm (slice a .. b) => (block))
        (arm (slice x (bind rest @ ..)) if (> x 0) => (block))
        (arm (& (slice (bind ref s) ..)) => (block))
        (arm (&mut (tstruct Some (bind ref q))) => (block))
        (arm (& (& c)) => (block))
        (arm y => (block))
        (arm (tuple (| a b) (| c d)) => (block))
        (arm (path <T as Trait>::CONST) => (block))
        (arm (| (path Self::A) (path Self::B)) => (block))
        (arm (struct S (0: a) (1: b)) => (block))
        (arm (mac m! (x)) => (block))
        (arm (| P Q) => (block))
        (arm _ => (block))))
      (let (tuple a (bind mut b)) = t)
      (let (struct Point x (y: py)) = p)
      (expr (for (& (tuple k (bind ref v))) in (method map iter) (block)))
      (expr (if (let (| (tstruct Some (range 1 ..= 5)) None) o) (block))))))
